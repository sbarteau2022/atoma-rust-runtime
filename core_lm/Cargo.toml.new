[package]
name = "core_lm"
version.workspace = true
edition.workspace = true
license.workspace = true
description = "Native Execution Plane for Monster Hybrid Server"

[features]
default = ["metal"]
# Apple Metal / MPS compute backend (macOS only). Disable with
# `--no-default-features` to build the portable CPU paths on other hosts.
metal = ["dep:metal"]

[dependencies]
serde = { workspace = true }
serde_json = { workspace = true }
fancy-regex = { workspace = true }
memmap2 = { workspace = true }
byteorder = { workspace = true }
# macOS-only Apple Metal bindings used by metal_quant.rs / metal/mod.rs.
metal = { workspace = true, optional = true }
